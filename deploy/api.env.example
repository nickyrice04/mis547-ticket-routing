# /etc/ticket-routing/api.env on the inference droplet (root-only, written by
# infra/scripts/bootstrap.sh from Terraform outputs). Placeholders only in this file.

# name:key pairs. Names appear in the audit log, keys never do.
API_KEYS=team:CHANGE_ME,grader:CHANGE_ME,replay:CHANGE_ME

# Tickets at or above this probability are routed automatically, the rest go to a person.
# At 0.7 the router auto-routes 87% of tickets at 98.3% accuracy (test set).
CONFIDENCE_THRESHOLD=0.7
RATE_LIMIT_PER_MINUTE=60

# Audit log, over the private network, TLS required, least-privilege user.
DATABASE_URL=postgresql+psycopg://router_api:CHANGE_ME@private-db-host:25060/routing?sslmode=require

# Model versions in Spaces, read-only key scoped to one bucket.
SPACES_REGION=tor1
SPACES_BUCKET=team3-ticket-routing-mis547
SPACES_KEY=CHANGE_ME
SPACES_SECRET=CHANGE_ME
MODEL_POLL_SECONDS=120
