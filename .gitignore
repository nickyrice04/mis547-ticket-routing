# environment
.venv/
__pycache__/
*.pyc
.DS_Store

# model weights and adapters, gigabytes, all reproducible from the scripts
models/
adapters/

# derived data, regenerated by the scripts in src/ (see data/README.md)
data/x_*/
data/lora*/
data/synthetic/*.jsonl
data/synthetic/seeds/

# keep the small files that define the protocol and record what was generated
!data/synthetic/split.json
!data/synthetic/*_summary.json
!data/synthetic/qwen_think_allocation.json
!data/synthetic/error_report.json
!data/synthetic/val_predictions.json

# Terraform: state holds database passwords and Spaces secrets, never commit it (Lecture 12)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/*.tfplan
infra/terraform/crash.log

# secrets and local runtime files
*.env
!deploy/*.env.example
artifacts/
evidence/*.sarif.tmp

# saved Terraform plans embed secret values
infra/terraform/tfplan
